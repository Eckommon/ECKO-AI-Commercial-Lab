{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Commercial Factory Storyboard",
  "type": "object",
  "required": ["campaignId", "durationSec", "shots"],
  "properties": {
    "campaignId": {"type": "string"},
    "durationSec": {"type": "number"},
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "startSec", "endSec", "purpose", "asset", "motion"],
        "properties": {
          "id": {"type": "string"},
          "startSec": {"type": "number"},
          "endSec": {"type": "number"},
          "purpose": {"type": "string"},
          "asset": {"type": "string"},
          "motion": {"type": "string"},
          "copy": {"type": "string"}
        }
      }
    }
  }
}
